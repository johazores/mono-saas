generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Tenant {
  id           String         @id @default(auto()) @map("_id") @db.ObjectId
  key          String         @unique
  name         String
  status       String         @default("active")
  domains      TenantDomain[]
  organization Organization?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

model TenantDomain {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  tenantId  String   @db.ObjectId
  host      String   @unique
  isPrimary Boolean  @default(false)
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

model Organization {
  id          String                   @id @default(auto()) @map("_id") @db.ObjectId
  tenantId    String                   @unique @db.ObjectId
  name        String
  slug        String
  status      String                   @default("active")
  tenant      Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberships OrganizationMembership[]
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt

  @@index([slug])
}

model OrganizationMembership {
  id                 String                   @id @default(auto()) @map("_id") @db.ObjectId
  tenantId           String                   @db.ObjectId
  organizationId     String                   @db.ObjectId
  userId             String                   @db.ObjectId
  parentMembershipId String?                  @db.ObjectId
  ancestors          String[]                 @db.ObjectId
  status             String                   @default("active")
  organization       Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user               User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent             OrganizationMembership?  @relation("OrganizationMembershipHierarchy", fields: [parentMembershipId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children           OrganizationMembership[] @relation("OrganizationMembershipHierarchy")
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  @@unique([organizationId, userId])
  @@index([tenantId])
  @@index([userId])
  @@index([parentMembershipId])
}

model ExternalIdentity {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  provider  String
  subject   String
  email     String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, subject])
  @@index([userId, provider])
}

model Admin {
  id                  String         @id @default(auto()) @map("_id") @db.ObjectId
  name                String
  email               String         @unique
  passwordHash        String
  role                String         @default("editor") // admin | editor
  status              String         @default("active") // active | disabled
  failedLoginAttempts Int            @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?
  sessions            AdminSession[]
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
}

model User {
  id                      String                   @id @default(auto()) @map("_id") @db.ObjectId
  env                     String                   @default("dev") // dev | production
  tenantId                String?                  @db.ObjectId
  email                   String
  clerkId                 String?
  name                    String
  passwordHash            String
  stripeCustomerId        String?                  // Stripe customer ID for billing portal
  status                  String                   @default("active") // active | disabled
  parentId                String?                  @db.ObjectId
  ancestors               String[]                 @db.ObjectId // materialized path of parent IDs (e.g. [parentId])
  failedLoginAttempts     Int                      @default(0)
  lockedUntil             DateTime?
  lastLoginAt             DateTime?
  phone                   String?
  address                 Json?
  parent                  User?                    @relation("UserHierarchy", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children                User[]                   @relation("UserHierarchy")
  sessions                UserSession[]
  purchases               Purchase[]
  memberships             Membership[]
  organizationMemberships OrganizationMembership[]
  externalIdentities      ExternalIdentity[]
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt

  @@unique([env, email])
  @@index([env, clerkId])
  @@index([tenantId])
}

model UserSession {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  env       String   @default("dev") // dev | production
  tenantId  String?  @db.ObjectId
  userId    String   @db.ObjectId
  tokenHash String   @unique
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

model UserInvitation {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  env       String   @default("dev")
  tenantId  String?  @db.ObjectId
  email     String
  name      String?
  tokenHash String   @unique
  status    String   @default("pending") // pending | accepted | expired
  expiresAt DateTime
  invitedBy String   @db.ObjectId
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([env, email])
  @@index([tenantId])
}

model AdminSession {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  adminId   String   @db.ObjectId
  tokenHash String   @unique
  expiresAt DateTime
  admin     Admin    @relation(fields: [adminId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ActivityLog {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  env        String   @default("dev") // dev | production
  tenantId   String?  @db.ObjectId
  actor      String // "admin" | "user" | "system"
  actorId    String?  @db.ObjectId
  actorEmail String?
  action     String // e.g. "admin.login", "user.register", "admin.create"
  resource   String? // e.g. "admin", "user", "profile"
  resourceId String?  @db.ObjectId
  metadata   Json?
  ip         String?
  userAgent  String?
  method     String? // HTTP method
  path       String? // Request path
  createdAt  DateTime @default(now())

  @@index([tenantId])
}

model Product {
  id                  String         @id @default(auto()) @map("_id") @db.ObjectId
  env                 String         @default("dev") // dev | production
  tenantId            String?        @db.ObjectId
  name                String
  slug                String
  description         String?
  type                String         @default("physical") // physical | digital | membership
  price               Float          @default(0)
  currency            String         @default("USD")
  paymentModel        String         @default("one-time") // one-time | recurring
  maxSubUsers         Int            @default(0) // 0 = none, -1 = unlimited
  accessKeys          String[]       // Feature keys unlocked by purchase
  stripeTestProductId String?        // Stripe product ID (test mode)
  stripeLiveProductId String?        // Stripe product ID (live mode)
  isActive            Boolean        @default(true)
  sortOrder           Int            @default(0)
  metadata            Json?
  purchases           Purchase[]
  prices              ProductPrice[]
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  @@unique([env, slug])
  @@index([tenantId])
}

model ProductPrice {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  env             String    @default("dev") // dev | production
  tenantId        String?   @db.ObjectId
  productId       String    @db.ObjectId
  label           String    // e.g. "Monthly 2024", "Launch Offer"
  stripePriceId   String    // Stripe price ID
  mode            String    @default("test") // test | live
  amount          Float
  currency        String    @default("USD")
  interval        String?   // month | year (null for one-time)
  startDate       DateTime  @default(now())
  endDate         DateTime? // null = no end date (active indefinitely)
  isDefault       Boolean   @default(false)
  metadata        Json?
  product         Product   @relation(fields: [productId], references: [id])
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([tenantId])
}

model Purchase {
  id              String         @id @default(auto()) @map("_id") @db.ObjectId
  env             String         @default("dev") // dev | production
  tenantId        String?        @db.ObjectId
  userId          String         @db.ObjectId
  productId       String         @db.ObjectId
  status          String         @default("completed") // pending | completed | refunded | failed | active | cancelled | expired
  amount          Float
  currency        String         @default("USD")
  externalId      String?        // Payment provider reference
  startDate       DateTime       @default(now())
  endDate         DateTime?
  cancelledAt     DateTime?
  metadata        Json?
  user            User           @relation(fields: [userId], references: [id])
  product         Product        @relation(fields: [productId], references: [id])
  files           PurchaseFile[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([tenantId])
}

model PurchaseFile {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  env             String   @default("dev") // dev | production
  tenantId        String?  @db.ObjectId
  purchaseId      String   @db.ObjectId
  fileName        String   // Display name
  mimeType        String   @default("application/octet-stream")
  sizeBytes       Int      @default(0)
  data            String?  // legacy base64 content; removed by T-1002
  storageProvider String?
  storageKey      String?
  checksum        String?
  metadata        Json?
  purchase        Purchase @relation(fields: [purchaseId], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([tenantId])
}

model Membership {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  env         String    @default("dev") // dev | production
  tenantId    String?   @db.ObjectId
  userId      String    @db.ObjectId
  type        String // "purchase"
  sourceId    String    @db.ObjectId // purchaseId
  featureKeys String[] // Features granted by this membership
  status      String    @default("active") // active | expired | revoked
  expiresAt   DateTime?
  user        User      @relation(fields: [userId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([tenantId])
}

model Feature {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  env         String   @default("dev") // dev | production
  tenantId    String?  @db.ObjectId
  key         String
  description String
  category    String
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([env, key])
  @@index([tenantId])
}

model SiteSetting {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  env       String   @default("dev") // dev | production
  tenantId  String?  @db.ObjectId
  key       String
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([env, key])
  @@index([tenantId])
}

model CheckoutSession {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  env        String   @default("dev") // dev | production
  tenantId   String?  @db.ObjectId
  sessionId  String   @unique // Payment provider session ID
  userId     String?  @db.ObjectId // null for guest checkout
  guestEmail String? // Guest checkout email
  guestName  String? // Guest checkout name
  items      Json // [{productId, quantity, priceId}]
  status     String   @default("pending") // pending | completed | expired
  provider   String   @default("stripe") // stripe | woocommerce (future)
  metadata   Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([tenantId])
}

// ---------------------------------------------------------------------------
// CMS
// ---------------------------------------------------------------------------

model Page {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  env            String   @default("dev") // dev | production
  tenantId       String?  @db.ObjectId
  title          String
  slug           String
  status         String   @default("draft") // draft | published
  isHomepage     Boolean  @default(false)
  seoTitle       String?
  seoDescription String?
  blocks         Json // PageBlock[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([env, slug])
  @@index([tenantId])
}

model ContentType {
  id             String        @id @default(auto()) @map("_id") @db.ObjectId
  env            String        @default("dev") // dev | production
  tenantId       String?       @db.ObjectId
  name           String
  slug           String
  pluralName     String
  icon           String?
  description    String?
  fields         Json // field definitions array
  settings       Json // { hasSlug, hasStatus, hasSortOrder, slugSource, defaultStatus }
  listDisplay    Json? // { titleField, subtitleField, imageField }
  publicSettings Json? // { hasPublicList, hasDetailPage, urlPrefix }
  status         String        @default("active") // active | inactive
  sortOrder      Int           @default(0)
  items          ContentItem[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([env, slug])
  @@index([tenantId])
}

model ContentItem {
  id              String      @id @default(auto()) @map("_id") @db.ObjectId
  env             String      @default("dev") // dev | production
  tenantId        String?     @db.ObjectId
  contentTypeId   String      @db.ObjectId
  contentTypeSlug String
  contentType     ContentType @relation(fields: [contentTypeId], references: [id])
  slug            String
  title           String
  data            Json // flexible field data
  status          String      @default("draft") // draft | published
  sortOrder       Int         @default(0)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@unique([env, contentTypeSlug, slug])
  @@index([env, contentTypeSlug, status])
  @@index([tenantId])
}

model Taxonomy {
  id           String         @id @default(auto()) @map("_id") @db.ObjectId
  env          String         @default("dev") // dev | production
  tenantId     String?        @db.ObjectId
  name         String
  slug         String
  pluralName   String
  description  String?
  hierarchical Boolean        @default(false)
  contentTypes String[] // slugs of associated content types
  status       String         @default("active") // active | inactive
  sortOrder    Int            @default(0)
  terms        TaxonomyTerm[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@unique([env, slug])
  @@index([tenantId])
}

model TaxonomyTerm {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  env         String   @default("dev") // dev | production
  tenantId    String?  @db.ObjectId
  taxonomyId  String   @db.ObjectId
  taxonomy    Taxonomy @relation(fields: [taxonomyId], references: [id], onDelete: Cascade)
  name        String
  slug        String
  description String?
  imageUrl    String?
  parentId    String?  @db.ObjectId
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([env, taxonomyId, slug])
  @@index([env, taxonomyId, parentId])
  @@index([tenantId])
}

model Media {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  env             String   @default("dev") // dev | production
  tenantId        String?  @db.ObjectId
  source          String   @default("upload") // upload | external
  fileName        String
  originalName    String
  url             String
  mimeType        String?
  size            Int?
  mediaType       String   @default("image") // image | document | file
  altText         String?
  base64Data      String?  // legacy base64 content; removed by T-1002
  storageProvider String?
  storageKey      String?
  checksum        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([tenantId])
}

model BlockTemplate {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  env         String   @default("dev") // dev | production
  tenantId    String?  @db.ObjectId
  name        String
  slug        String
  description String?
  icon        String? // Lucide icon name
  category    String   @default("content") // layout | content | media | cta
  fields      Json // ContentFieldDefinition[]
  defaults    Json? // default values per field
  preview     String? // optional HTML preview snippet
  status      String   @default("active") // active | inactive
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([env, slug])
  @@index([tenantId])
}

model SystemConfig {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt
}
