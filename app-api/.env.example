# Mono SaaS API bootstrap environment
# Administrator-managed runtime configuration and provider credentials belong in encrypted database-backed settings.

# Database
DATABASE_URL="mongodb://localhost:27017/mono-saas"

# Auth — required, minimum 32 characters
ADMIN_SESSION_SECRET="change-me-at-least-32-characters-long"
USER_SESSION_SECRET="change-me-at-least-32-characters-long"

# Settings encryption — required in production
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY="replace-with-a-32-byte-base64-key"
ENCRYPTION_KEY_VERSION="1"
# During key rotation, retain old keys by version until all values are re-encrypted:
# ENCRYPTION_KEY_V1="previous-32-byte-base64-key"

# Runtime / transitional deployment scope
NODE_ENV="development"
APP_ENV="dev"  # dev | production — removed by T-305 tenant migration

# Tenant resolution — required only when global SystemConfig TENANT_RESOLUTION.mode is "trusted-header"
# Use a unique random secret of at least 32 characters. Never expose it to browsers.
TENANT_RESOLUTION_SHARED_SECRET=""
